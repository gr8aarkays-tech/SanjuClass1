# AI Provider configuration
# Copy this file to .env and fill in your values.

# ── Provider selection ────────────────────────────────────────────────────────
# Options: mock | openai | anthropic | watsonx
# "mock" uses deterministic fake responses — no API key needed (default).
VITE_AI_PROVIDER=mock

# ── OpenAI (VITE_AI_PROVIDER=openai) ─────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# Used for: text analysis (gpt-4o-mini) + image OCR (gpt-4o-mini vision)
VITE_AI_API_KEY=

# ── Anthropic (VITE_AI_PROVIDER=anthropic) ───────────────────────────────────
# Get your key at https://console.anthropic.com/
# Used for: text analysis (claude-haiku-4-5) + image OCR (claude-haiku-4-5 vision)
# Note: same VITE_AI_API_KEY variable is used for Anthropic as well.
# VITE_AI_API_KEY=sk-ant-...

# ── watsonx.ai (VITE_AI_PROVIDER=watsonx) ────────────────────────────────────
# Text analysis only (no vision/image support).
# VITE_WATSONX_URL=https://us-south.ml.cloud.ibm.com
# VITE_WATSONX_TOKEN=<IAM bearer token>
# VITE_WATSONX_PROJECT_ID=<your project id>
# VITE_WATSONX_MODEL=ibm/granite-3-8b-instruct

# ── Application ───────────────────────────────────────────────────────────────
VITE_APP_TITLE=AI School Learning Assistant
