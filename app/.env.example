# AI Provider configuration
# Copy this file to .env and fill in your values.

# Set to 'mock' for local development (no API key needed)
# Options: mock | openai | watsonx | anthropic
VITE_AI_PROVIDER=mock

# API key for the selected AI provider (leave empty for mock)
VITE_AI_API_KEY=

# Application title
VITE_APP_TITLE=AI School Learning Assistant
